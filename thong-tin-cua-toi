<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Link in Bio - Free Fire Style</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Inter & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%);
            min-height: 100vh;
            color: #f8fafc;
        }
        /* Hiệu ứng phát sáng viền kính đặc trưng */
        .glass-box {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }
        .link-card {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .link-card:hover {
            transform: translateY(-3px);
            border-color: rgba(129, 140, 248, 0.5);
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.25);
            background: rgba(30, 41, 59, 0.9);
        }
        /* Hiệu ứng chớp sáng avatar */
        .avatar-glow {
            box-shadow: 0 0 25px rgba(129, 140, 248, 0.4), 0 0 50px rgba(168, 85, 247, 0.2);
        }
    </style>
</head>
<body class="py-12 px-4 sm:px-6 relative overflow-x-hidden">

    <!-- Background glowing decorative blobs -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-indigo-600/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-[400px] h-[400px] bg-violet-600/15 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-md mx-auto relative z-10 space-y-8">

        <!-- -->
        <!-- PROFILE HEADER -->
        <div class="text-center space-y-4 pt-4">
            <!-- Avatar -->
            <div class="relative inline-block">
                <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1 bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 avatar-glow mx-auto">
                    <img src="https://placehold.co/150x150/1e1b4b/ffffff?text=FF" alt="Avatar" class="w-full h-full rounded-full object-cover border-2 border-slate-900">
                </div>
                <span class="absolute bottom-1 right-1 w-5 h-5 bg-emerald-500 border-2 border-slate-900 rounded-full"></span>
            </div>

            <!-- Title & Subtitle -->
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-wide uppercase bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
                    Ê MENU FF
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 font-medium tracking-widest mt-1 opacity-90">
                    TẤT CẢ LINK MENU & NHÓM Ở ĐÂY
                </p>
            </div>

            <!-- Social Media Icons -->
            <div class="flex items-center justify-center space-x-4 pt-2">
                <a href="https://tiktok.com" target="_blank" class="w-11 h-11 rounded-full glass-box flex items-center justify-center text-white hover:text-indigo-400 hover:scale-110 transition-all">
                    <i class="fa-brands fa-tiktok text-lg"></i>
                </a>
                <a href="https://telegram.org" target="_blank" class="w-11 h-11 rounded-full glass-box flex items-center justify-center text-white hover:text-indigo-400 hover:scale-110 transition-all">
                    <i class="fa-brands fa-telegram text-lg"></i>
                </a>
                <a href="https://youtube.com" target="_blank" class="w-11 h-11 rounded-full glass-box flex items-center justify-center text-white hover:text-indigo-400 hover:scale-110 transition-all">
                    <i class="fa-brands fa-youtube text-lg"></i>
                </a>
                <a href="https://facebook.com" target="_blank" class="w-11 h-11 rounded-full glass-box flex items-center justify-center text-white hover:text-indigo-400 hover:scale-110 transition-all">
                    <i class="fa-brands fa-facebook-f text-lg"></i>
                </a>
            </div>
        </div>

        <!-- -->
        <!-- SECTION 1: FREE FIRE / MENU CHÍNH -->
        <div class="glass-box rounded-2xl p-4 sm:p-5 space-y-3 shadow-xl">
            <div class="flex items-center space-x-2 text-indigo-400 font-bold text-xs uppercase tracking-widest px-1">
                <i class="fa-solid fa-gamepad"></i>
                <span>Free Fire Menu & Tools</span>
            </div>

            <div class="space-y-3">
                <!-- Link 1 -->
                <a href="#modal-1" onclick="openModal('menu-no-root')" class="link-card flex items-center p-3 rounded-xl cursor-pointer group">
                    <img src="https://placehold.co/60x60/4f46e5/ffffff?text=NO+ROOT" alt="Icon" class="w-14 h-14 rounded-lg object-cover flex-shrink-0 border border-slate-700 group-hover:border-indigo-500 transition-colors">
                    <div class="ml-4 flex-grow">
                        <h2 class="text-sm font-bold text-white group-hover:text-indigo-300 transition-colors">MENU NO ROOT</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Tất cả bản no root mới nhất cập nhật 2026</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-indigo-400 mr-1 transition-transform group-hover:translate-x-1"></i>
                </a>

                <!-- Link 2 -->
                <a href="#modal-2" onclick="openModal('menu-root')" class="link-card flex items-center p-3 rounded-xl cursor-pointer group">
                    <img src="https://placehold.co/60x60/7c3aed/ffffff?text=ROOT" alt="Icon" class="w-14 h-14 rounded-lg object-cover flex-shrink-0 border border-slate-700 group-hover:border-indigo-500 transition-colors">
                    <div class="ml-4 flex-grow">
                        <h2 class="text-sm font-bold text-white group-hover:text-indigo-300 transition-colors">MENU ROOT</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Tất cả menu có root bản chuẩn tối ưu</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-indigo-400 mr-1 transition-transform group-hover:translate-x-1"></i>
                </a>

                <!-- Link 3 -->
                <a href="#modal-3" onclick="openModal('file-dinh-vi')" class="link-card flex items-center p-3 rounded-xl cursor-pointer group">
                    <img src="https://placehold.co/60x60/db2777/ffffff?text=GPS" alt="Icon" class="w-14 h-14 rounded-lg object-cover flex-shrink-0 border border-slate-700 group-hover:border-indigo-500 transition-colors">
                    <div class="ml-4 flex-grow">
                        <h2 class="text-sm font-bold text-white group-hover:text-indigo-300 transition-colors">FILE ĐỊNH VỊ</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Tất cả file định vị free fire mới nhất</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-indigo-400 mr-1 transition-transform group-hover:translate-x-1"></i>
                </a>

                <!-- Link 4 -->
                <a href="#modal-4" onclick="openModal('proxy-ff')" class="link-card flex items-center p-3 rounded-xl cursor-pointer group">
                    <img src="https://placehold.co/60x60/0d9488/ffffff?text=PROXY" alt="Icon" class="w-14 h-14 rounded-lg object-cover flex-shrink-0 border border-slate-700 group-hover:border-indigo-500 transition-colors">
                    <div class="ml-4 flex-grow">
                        <h2 class="text-sm font-bold text-white group-hover:text-indigo-300 transition-colors">PROXY FREEFIRE</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Tất cả proxy freefire ping thấp siêu mượt</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-indigo-400 mr-1 transition-transform group-hover:translate-x-1"></i>
                </a>
            </div>
        </div>

        <!-- -->
        <!-- SECTION 2: GIỚI THIỆU 2 NHÓM CỦA TÔI -->
        <div class="glass-box rounded-2xl p-4 sm:p-5 space-y-3 shadow-xl">
            <div class="flex items-center space-x-2 text-pink-400 font-bold text-xs uppercase tracking-widest px-1">
                <i class="fa-solid fa-users-rectangle"></i>
                <span>Nhóm Của Tôi & Đội Ngũ</span>
            </div>

            <div class="space-y-3">
                <!-- Group 1 -->
                <div onclick="openGroupModal('group1')" class="link-card flex items-center p-3 rounded-xl cursor-pointer group">
                    <div class="w-14 h-14 rounded-lg bg-gradient-to-tr from-indigo-600 to-violet-600 flex items-center justify-center text-white text-xl flex-shrink-0">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <div class="ml-4 flex-grow">
                        <h2 class="text-sm font-bold text-white group-hover:text-pink-300 transition-colors">NHÓM 1: TECH INNOVATORS</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Chuyên phát triển tool, mod game & web apps</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-pink-400 mr-1 transition-transform group-hover:translate-x-1"></i>
                </div>

                <!-- Group 2 -->
                <div onclick="openGroupModal('group2')" class="link-card flex items-center p-3 rounded-xl cursor-pointer group">
                    <div class="w-14 h-14 rounded-lg bg-gradient-to-tr from-purple-600 to-pink-600 flex items-center justify-center text-white text-xl flex-shrink-0">
                        <i class="fa-solid fa-bullhorn"></i>
                    </div>
                    <div class="ml-4 flex-grow">
                        <h2 class="text-sm font-bold text-white group-hover:text-pink-300 transition-colors">NHÓM 2: CREATIVE MEDIA</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Chuyên làm video highlight, edit & truyền thông</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-pink-400 mr-1 transition-transform group-hover:translate-x-1"></i>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-xs text-slate-500 pt-2 pb-6">
            <p>© 2026 Ê Menu FF. All Rights Reserved.</p>
        </div>

    </div>

    <!-- -->
    <!-- MODAL POPUP CHI TIẾT -->
    <div id="info-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-all">
        <div class="glass-box max-w-sm w-full rounded-2xl p-6 relative border border-indigo-500/30 shadow-2xl space-y-4">
            <button onclick="closeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white w-8 h-8 rounded-full bg-slate-800/80 flex items-center justify-center">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div id="modal-content" class="space-y-3 pt-2">
                <!-- Nội dung sẽ được điền bằng Javascript -->
            </div>
            <button onclick="closeModal()" class="w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-semibold text-xs tracking-wider uppercase shadow-lg shadow-indigo-600/30">
                Đóng lại
            </button>
        </div>
    </div>

    <!-- -->
    <script>
        const modalData = {
            'menu-no-root': {
                title: 'MENU NO ROOT',
                desc: 'Bản cập nhật mới nhất cho Android & iOS không cần root máy. Antiban an toàn, đầy đủ tính năng hỗ trợ leo rank mượt mà.',
                link: '#'
            },
            'menu-root': {
                title: 'MENU ROOT',
                desc: 'Phiên bản đặc biệt dành cho máy đã root. Tối ưu hóa sâu hệ thống, hiệu suất cực cao và nhiều tính năng độc quyền.',
                link: '#'
            },
            'file-dinh-vi': {
                title: 'FILE ĐỊNH VỊ',
                desc: 'Bộ sưu tập file định vị chính xác vị trí địch, fix lag và tối ưu hóa băng thông mạng khi chơi game.',
                link: '#'
            },
            'proxy-ff': {
                title: 'PROXY FREEFIRE',
                desc: 'Danh sách proxy tốc độ cao, giảm ping tối đa, vượt rào cản mạng ổn định suốt trận đấu.',
                link: '#'
            },
            'group1': {
                title: 'NHÓM 1: TECH INNOVATORS',
                desc: 'Đội ngũ bao gồm các coder và modder chuyên nghiệp. Chuyên nghiên cứu các giải pháp công nghệ, phát triển tool hỗ trợ và ứng dụng tiện ích cho cộng đồng game thủ.',
                link: '#'
            },
            'group2': {
                title: 'NHÓM 2: CREATIVE MEDIA',
                desc: 'Đội ngũ sáng tạo nội dung, chuyên sản xuất video highlight Free Fire mãn nhãn, thiết kế đồ họa banner, poster và quản lý các kênh mạng xã hội triệu view.',
                link: '#'
            }
        };

        function openModal(key) {
            const data = modalData[key];
            if (!data) return;
            
            const contentDiv = document.getElementById('modal-content');
            contentDiv.innerHTML = `
                <div class="w-12 h-12 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-2xl mb-2">
                    <i class="fa-solid fa-fire"></i>
                </div>
                <h3 class="text-lg font-bold text-white">${data.title}</h3>
                <p class="text-xs text-slate-300 leading-relaxed">${data.desc}</p>
                <div class="pt-2">
                    <a href="${data.link}" class="block w-full py-3 text-center rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-indigo-600/30 transition-all">
                        Tải về / Truy cập ngay
                    </a>
                </div>
            `;
            
            document.getElementById('info-modal').classList.remove('hidden');
        }

        function openGroupModal(key) {
            openModal(key);
        }

        function closeModal() {
            document.getElementById('info-modal').classList.add('hidden');
        }

        // Đóng modal khi bấm ra ngoài
        window.onclick = function(event) {
            const modal = document.getElementById('info-modal');
            if (event.target === modal) {
                closeModal();
            }
        }
    </script>
</body>
</html>
